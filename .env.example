# Required for production: use short-lived credentials issued by your TURN service.
VITE_TURN_URL=turns:turn.example.com:5349?transport=tcp
VITE_TURN_USERNAME=replace-with-ephemeral-username
VITE_TURN_CREDENTIAL=replace-with-ephemeral-credential

# AWS Cognito Authentication configuration
VITE_COGNITO_USER_POOL_ID=us-east-1_example
VITE_COGNITO_CLIENT_ID=exampleclientid
VITE_COGNITO_REGION=us-east-1
